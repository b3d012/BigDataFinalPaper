# Ignore everything by default so GitHub stays small and professional.
*

# Keep folders explorable
!*/

# Keep source, docs, tests, schemas, and lightweight metadata.
!src/
!src/**/*.py
!docs/
!docs/**/*.md
!tests/
!tests/**/*.py
!schemas/
!schemas/**/*.json
!models/
!models/*.json
!output/
!output/reports/
!output/reports/*.json
!output/reports/*.md
!output/demo/
!output/demo/*.json
!output/demo/*.md

# Do not publish local live-capture state, logs, datasets, PCAPs, model
# binaries, generated figures, paper builds, caches, or IDE settings.

# Keep Python source
!*.py

# Keep notebooks
!*.ipynb

# Keep markdown docs
!*.md

# Keep root install files
!requirements.txt
!environment.yml

# Keep env file
!environment-edgeids.yml

# Keep gitignore itself
!.gitignore

# Keep repository docs and root config files
!README.md
!*.md
!*.txt

# Explicit generated/local exclusions.
.pytest_cache/
.vscode/
__pycache__/
**/__pycache__/
/data/
/demo/
/Screenshots/
/extrafigs/
/output/live/
/output/figures/
*.aux
*.log
*.pdf
*.docx
models/*.joblib
models/*.csv
output/**/*.csv
